# 面板映射到宿主机的端口
PANEL_PORT=8000

# 面板登录密码，部署后请务必修改
PANEL_PASSWORD=admin123

# 容器内时区，同时作为 cron 默认时区（可在面板中修改）
TZ=Asia/Shanghai

# 日志级别：DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# 以下为 AI 聊天机器人的可选初始值（均可在面板「AI 机器人」页签里配置）
# Bot Token 从 @BotFather 用 /newbot 获取；AI 接口兼容 OpenAI 协议
# BOT_TOKEN=
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=
# AI_MODEL=deepseek-chat
