{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tg-checkin-cf",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tg-checkin",
      "database_id": "跑 wrangler d1 create tg-checkin 后把 id 填这里",
      "preview_database_id": "跑 wrangler d1 create tg-checkin-preview 后把 id 填这里"
    }
  ],
  "vars": {
    "PANEL_PASSWORD": "admin123",
    "APP_TITLE": "AI 机器人控制台"
  }
}
